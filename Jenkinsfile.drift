
pipeline {
    agent {
        label 'docker-aws-maven'
    }

    triggers {
        cron('H/3 * * * *')
    }

    options {
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Drift Check') {
            steps {
                dir('terraform') {
                    sh 'terraform init -input=false -no-color'

                    script {
                        def code = sh(
                            script: '''
                                terraform plan \
                                    -detailed-exitcode \
                                    -input=false \
                                    -no-color \
                                    > drift-report.txt 2>&1
                            ''',
                            returnStatus: true
                        )

                        sh 'cat drift-report.txt'

                        if (code == 2) {
                            unstable('Terraform proposes changes')
                        } else if (code != 0) {
                            error('Terraform plan failed')
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts(
                artifacts: 'terraform/drift-report.txt',
                allowEmptyArchive: true
            )
        }

        changed {
            script {
                def status = currentBuild.currentResult
                def message

                if (status == 'UNSTABLE') {
                    message = '⚠️ Terraform detected changes!'
                } else if (status == 'SUCCESS') {
                    message = '✅ Infrastructure check is healthy again!'
                } else {
                    message = '❌ Terraform drift check failed!'
                }

                slackSend(
                    channel: '#infra-alerts',
                    message: """${message}
Report: ${env.BUILD_URL}artifact/terraform/drift-report.txt"""
                )
            }
        }
    }
}



